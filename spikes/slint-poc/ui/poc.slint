// Phase 0 spike: transparent frameless window, custom title bar, one glass card
// with a 2px/1px bar chart updated by Rust every 500 ms.

component TitleButton inherits Rectangle {
    in property <string> glyph;
    // System icon-theme icon; falls back to `glyph` when the theme has none.
    in property <image> icon;
    in property <bool> danger;
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: ta.has-hover ? (danger ? #e5484d : #ffffff26) : transparent;
    if icon.width > 0: Image {
        source: icon;
        width: 16px;
        height: 16px;
        // Theme icons are monochrome; tint them with the title-bar foreground.
        colorize: #f2f4f8;
    }
    if icon.width == 0: Text {
        text: glyph;
        color: #f2f4f8;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Quarter-arc of a 1px edge; `commands` places the arc for one corner.
component EdgeArc inherits Path {
    in property <length> radius;
    width: radius;
    height: radius;
    // Path maps the viewbox onto (size - stroke-width) shifted by half the stroke,
    // so a viewbox of radius - 1 is 1:1 with pixels.
    viewbox-width: radius / 1px - 1;
    viewbox-height: radius / 1px - 1;
    fill: transparent;
    stroke-width: 1px;
}

// Rounded glass panel. The fill is a border-less rounded Rectangle (clean
// anti-aliasing); the 1px edge is drawn separately because the software
// renderer's Rectangle border double-blends pixels on the arc (bright beads =
// jagged corners). Corners use small Paths: a Path is re-rasterised on every
// repaint, so one window-sized Path would cost CPU on each chart update.
component GlassPanel inherits Rectangle {
    in property <length> radius;
    in property <brush> fill;
    in property <brush> edge;
    border-radius: radius;
    background: fill;
    // Stroke centre-line radius (outer radius = `radius`) and viewbox extent.
    property <float> a: radius / 1px - 0.5;
    property <float> v: radius / 1px - 1;
    Rectangle { x: radius; y: 0; width: parent.width - 2 * radius; height: 1px; background: edge; }
    Rectangle { x: radius; y: parent.height - 1px; width: parent.width - 2 * radius; height: 1px; background: edge; }
    Rectangle { x: 0; y: radius; width: 1px; height: parent.height - 2 * radius; background: edge; }
    Rectangle { x: parent.width - 1px; y: radius; width: 1px; height: parent.height - 2 * radius; background: edge; }
    if radius > 1px: EdgeArc {
        x: 0;
        y: 0;
        radius: root.radius;
        stroke: edge;
        commands: "M 0 \{a} A \{a} \{a} 0 0 1 \{a} 0";
    }
    if radius > 1px: EdgeArc {
        x: parent.width - root.radius;
        y: 0;
        radius: root.radius;
        stroke: edge;
        commands: "M -0.5 0 A \{a} \{a} 0 0 1 \{v} \{a}";
    }
    if radius > 1px: EdgeArc {
        x: parent.width - root.radius;
        y: parent.height - root.radius;
        radius: root.radius;
        stroke: edge;
        commands: "M \{v} -0.5 A \{a} \{a} 0 0 1 -0.5 \{v}";
    }
    if radius > 1px: EdgeArc {
        x: 0;
        y: parent.height - root.radius;
        radius: root.radius;
        stroke: edge;
        commands: "M \{a} \{v} A \{a} \{a} 0 0 1 0 -0.5";
    }
    @children
}

export component Poc inherits Window {
    in property <bool> glass: true;
    in property <string> bars-path: "";
    in property <string> cpu-text: "--";
    in property <bool> maximized-state;
    in property <image> icon-minimize;
    in property <image> icon-maximize;
    in property <image> icon-restore;
    in property <image> icon-close;
    out property <length> chart-width: chart.width;
    out property <length> chart-height: chart.height;
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    // Redraw bars as soon as the chart is resized instead of on the next tick.
    callback chart-resized();
    changed chart-width => { root.chart-resized(); }
    changed chart-height => { root.chart-resized(); }

    title: "ResourceWatch";
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 520px;
    preferred-height: 340px;
    min-width: 320px;
    min-height: 220px;
    background: transparent;

    // Layer 1: window glass (the compositor blurs what is behind it).
    GlassPanel {
        radius: maximized-state ? 0 : 16px;
        fill: glass ? #0d1424b3 : #0d1424;
        edge: #ffffff1f;

        VerticalLayout {
            padding: 10px;
            spacing: 10px;

            // Custom title bar: drag to move, double-click to maximize.
            Rectangle {
                height: 32px;
                WindowMoveArea {
                    TouchArea {
                        double-clicked => { root.toggle-maximize(); }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    spacing: 4px;
                    Text {
                        text: "ResourceWatch · Slint PoC";
                        color: #f2f4f8;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // KDE order: minimize, maximize, close.
                    TitleButton { glyph: "–"; icon: icon-minimize; clicked => { root.minimize(); } }
                    TitleButton {
                        glyph: maximized-state ? "❐" : "□";
                        icon: maximized-state ? icon-restore : icon-maximize;
                        clicked => { root.toggle-maximize(); }
                    }
                    TitleButton { glyph: "✕"; icon: icon-close; danger: true; clicked => { root.close-window(); } }
                }
            }

            // Layer 3: content card.
            GlassPanel {
                radius: 14px;
                fill: #ffffff14;
                edge: #ffffff26;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000059;
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: "CPU"; color: #ffffffa6; font-size: 12px; font-weight: 600; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: cpu-text; color: #4fd8ff; font-size: 20px; font-weight: 700; }
                    }
                    chart := Rectangle {
                        vertical-stretch: 1;
                        border-radius: 8px;
                        background: #00000026;
                        // Bars are generated in Rust in pixel units (2px bar + 1px gap, right-aligned).
                        Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-width: self.width / 1px;
                            viewbox-height: self.height / 1px;
                            commands: bars-path;
                            fill: #4fd8ff;
                            stroke-width: 0;
                        }
                    }
                }
            }
        }
    }
}
