import { Theme } from "theme.slint";
import { GlassPanel } from "glass.slint";
import { Icons, LineIcon } from "icons.slint";

export struct NavEntry {
    title: string,
    icon: string,
}

component SidebarButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> collapsed;
    callback clicked;
    height: 36px;
    border-radius: 10px;
    background: selected ? Theme.selected : (ta.has-hover ? Theme.hover : transparent);
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 10px;
        LineIcon {
            commands: icon;
            color: selected ? Theme.text : Theme.text-secondary;
            y: (parent.height - self.height) / 2;
        }
        if !collapsed: Text {
            text: label;
            font-size: 13px;
            font-weight: selected ? 600 : 400;
            color: selected ? Theme.text : Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Layer 2: floating sidebar. `pages` are the main pages; settings (page index
// `pages.length`) sits at the bottom.
export component Sidebar inherits GlassPanel {
    in property <[NavEntry]> pages;
    in property <bool> collapsed;
    in property <string> theme-label;
    in property <string> version;
    in-out property <int> page;
    callback toggle-collapsed();
    callback cycle-theme();

    width: collapsed ? 56px : 208px;
    animate width { duration: 160ms; easing: ease-out; }
    radius: 14px;
    fill: Theme.sidebar-glass;
    edge-top: Theme.edge-top;
    edge-bottom: Theme.edge-bottom;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: Theme.shadow;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        HorizontalLayout {
            height: 40px;
            spacing: 8px;
            if !collapsed: Image {
                source: @image-url("../../../src-tauri/icons/64x64.png");
                width: 24px;
                height: 24px;
                y: (parent.height - self.height) / 2;
            }
            if !collapsed: Text {
                text: "ResourceWatch";
                font-size: 14px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            SidebarButton {
                width: 36px;
                icon: collapsed ? Icons.expand : Icons.collapse;
                label: collapsed ? "展開側欄" : "收合側欄";
                collapsed: true;
                clicked => { root.toggle-collapsed(); }
            }
        }
        Rectangle { height: 6px; }
        for entry[i] in pages: SidebarButton {
            icon: entry.icon;
            label: entry.title;
            selected: root.page == i;
            collapsed: root.collapsed;
            clicked => { root.page = i; }
        }
        Rectangle { vertical-stretch: 1; }
        SidebarButton {
            icon: Icons.settings;
            label: "設定";
            selected: root.page == pages.length;
            collapsed: root.collapsed;
            clicked => { root.page = pages.length; }
        }
        SidebarButton {
            icon: Icons.theme;
            label: "主題：\{theme-label}";
            collapsed: root.collapsed;
            clicked => { root.cycle-theme(); }
        }
        if !collapsed: Text {
            text: "ResourceWatch \{version}";
            font-size: 10px;
            color: Theme.text-tertiary;
            horizontal-alignment: center;
        }
    }
}
