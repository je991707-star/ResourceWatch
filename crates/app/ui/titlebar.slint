import { Theme } from "theme.slint";

// Window-control glyphs in the KDE Breeze style (thin 1px line, square,
// overlapping squares, cross). KWin decoration themes are not icon-theme
// icons and cannot be loaded, so the default Breeze look is drawn here.
// Viewbox = size - 1 (see EdgeArc), so integer coordinates sit on pixel centres.
component WindowGlyph inherits Path {
    in property <color> color;
    width: 16px;
    height: 16px;
    viewbox-width: 15;
    viewbox-height: 15;
    fill: transparent;
    stroke: color;
    stroke-width: 1px;
}

component WindowButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> danger;
    in property <string> label;
    callback clicked;
    width: 30px;
    height: 26px;
    border-radius: 6px;
    background: ta.has-hover ? (danger ? Theme.danger : Theme.hover) : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    WindowGlyph {
        commands: glyph;
        color: ta.has-hover && danger ? #ffffff : (ta.has-hover ? Theme.text : Theme.text-secondary);
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// KDE order on the right: minimize, maximize/restore, close.
export component WindowButtons inherits HorizontalLayout {
    in property <bool> maximized;
    callback minimize();
    callback toggle-maximize();
    callback close();
    spacing: 2px;
    alignment: end;
    WindowButton {
        label: "最小化";
        glyph: "M2 8 L13 8";
        clicked => { root.minimize(); }
    }
    WindowButton {
        label: maximized ? "還原" : "最大化";
        glyph: maximized ? "M5 3 L12 3 L12 10 L5 10 Z M3 5 L3 12 L10 12" : "M3 3 L12 3 L12 12 L3 12 Z";
        clicked => { root.toggle-maximize(); }
    }
    WindowButton {
        label: "關閉";
        glyph: "M3 3 L12 12 M12 3 L3 12";
        danger: true;
        clicked => { root.close(); }
    }
}

// Host summary in the title bar; elides when the window is narrow.
export component HostBar inherits HorizontalLayout {
    in property <string> hostname;
    in property <string> uptime;
    in property <string> machine-model;
    in property <string> cpu-name;
    in property <bool> mock;
    spacing: 10px;
    Text {
        horizontal-stretch: 1;
        vertical-alignment: center;
        overflow: elide;
        font-size: 12px;
        color: Theme.text-secondary;
        text: "\{hostname}  ·  運作 \{uptime}  ·  \{machine-model}  ·  \{cpu-name}";
    }
    if mock: VerticalLayout {
        alignment: center;
        Rectangle {
            border-radius: 11px;
            background: Theme.warning-bg;
            height: 22px;
            width: badge.preferred-width + 20px;
            badge := Text {
                text: "模擬資料 · 非實機";
                font-size: 11px;
                font-weight: 600;
                color: Theme.warning-text;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}
