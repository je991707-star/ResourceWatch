import { Theme } from "theme.slint";

// Small downward chevron; viewbox = size - stroke (see EdgeArc in glass.slint).
component Chevron inherits Path {
    in property <color> color;
    width: 9px;
    height: 6px;
    viewbox-width: 7.8;
    viewbox-height: 4.8;
    fill: transparent;
    stroke: color;
    stroke-width: 1.2px;
    stroke-line-cap: round;
    commands: "M0 0 L3.9 4.8 L7.8 0";
}

// Pill-shaped dropdown for a card header ("NIC: enp3s0 ▾", "GPU: …").
export component PillSelect inherits Rectangle {
    in property <string> label;
    in property <[string]> options;
    in-out property <int> current;
    callback selected(int);
    height: 22px;
    width: row.preferred-width;
    border-radius: self.height / 2;
    background: ta.has-hover ? Theme.selected : Theme.hover;
    accessible-role: combobox;
    accessible-label: label;
    accessible-value: options[current];
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 9px;
        spacing: 6px;
        Text {
            text: label == "" ? options[current] : "\{label}: \{options[current]}";
            font-size: 11px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            max-width: 180px;
        }
        Chevron {
            color: Theme.text-secondary;
            y: (parent.height - self.height) / 2;
        }
    }
    ta := TouchArea {
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 140px);
        close-policy: close-on-click;
        Rectangle {
            border-radius: 10px;
            background: Theme.dark ? #1b2232f2 : #fbfcfef2;
            border-width: 1px;
            border-color: Theme.edge-bottom;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;
            VerticalLayout {
                padding: 4px;
                for option[i] in root.options: Rectangle {
                    height: 26px;
                    border-radius: 6px;
                    background: item.has-hover ? Theme.hover : (i == root.current ? Theme.selected : transparent);
                    Text {
                        x: 8px;
                        text: option;
                        font-size: 12px;
                        color: Theme.text;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    item := TouchArea {
                        clicked => {
                            root.current = i;
                            root.selected(i);
                        }
                    }
                }
            }
        }
    }
}

// Segmented control (°C / °F, theme). `current` is the selected index.
export component SegmentedControl inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback selected(int);
    height: 24px;
    border-radius: self.height / 2;
    background: Theme.hover;
    accessible-role: tab-list;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for option[i] in root.options: Rectangle {
            min-width: label.preferred-width + 20px;
            border-radius: self.height / 2;
            background: i == root.current ? Theme.selected : (seg.has-hover ? Theme.hover : transparent);
            drop-shadow-blur: i == root.current ? 4px : 0;
            drop-shadow-color: Theme.shadow;
            accessible-role: tab;
            accessible-label: option;
            accessible-item-selected: i == root.current;
            label := Text {
                text: option;
                font-size: 11px;
                font-weight: i == root.current ? 600 : 400;
                color: i == root.current ? Theme.text : Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            seg := TouchArea {
                clicked => {
                    root.current = i;
                    root.selected(i);
                }
            }
        }
    }
}
