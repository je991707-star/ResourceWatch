import { Theme } from "theme.slint";
import { GlassPanel } from "glass.slint";
import { PillSelect, SegmentedControl } from "controls.slint";

// Section heading inside a card, like SUMMARY's sub-headings ("Memory", "Storage").
export component SectionHeading inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Theme.text-secondary;
}

// Layer 3 content card in the SUMMARY layout: uppercase title row, optional
// header pill dropdown (`pill-options`) or segmented control (`segments`),
// then the children stacked vertically.
export component GlassCard inherits GlassPanel {
    in property <string> title;
    in property <string> pill-label;
    in property <[string]> pill-options;
    in-out property <int> pill-index;
    in property <[string]> segments;
    in-out property <int> segment-index;
    callback pill-selected(int);
    callback segment-selected(int);

    radius: 20px;
    fill: Theme.card-glass;
    edge-top: Theme.card-border;
    edge-bottom: Theme.card-border;
    drop-shadow-blur: 32px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.card-shadow;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            height: 24px;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 0.8px;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.pill-options.length > 0: VerticalLayout {
                alignment: center;
                PillSelect {
                    label: root.pill-label;
                    options: root.pill-options;
                    current <=> root.pill-index;
                    selected(i) => { root.pill-selected(i); }
                }
            }
            if root.segments.length > 0: VerticalLayout {
                alignment: center;
                SegmentedControl {
                    options: root.segments;
                    current <=> root.segment-index;
                    selected(i) => { root.segment-selected(i); }
                }
            }
        }
        @children
    }
}
