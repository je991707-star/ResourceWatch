// Live values shown by the dashboard (and later the detail pages), set by Rust
// (`dashboard.rs`) from each snapshot. Texts are pre-formatted; missing values
// arrive as "--", fractions/percents < 0 mean missing. Lists are models that
// Rust updates in place; an array literal built in Slint from changing values
// would recreate its repeated elements on every cycle.
import { StackPart, LegendItem, KeyValue } from "gauges.slint";

export struct DiskRow {
    name: string,
    model: string, // "model · size · TRANSPORT"
    read: string,
    write: string,
    usage: float, // 0..1, < 0 = not mounted
    usage-text: string,
}

export global Dash {
    // SUMMARY / Processor
    in property <float> cpu-percent: -1;
    in property <string> cpu-usage: "--";
    in property <string> cpu-temp: "--";
    in property <string> cpu-speed: "--";
    in property <[float]> cores; // per logical CPU, 0..100, < 0 missing
    in property <string> cpu-path;
    in property <[KeyValue]> top-cpu;
    // Graphics
    in property <float> gpu-percent: -1;
    in property <string> gpu-usage: "--";
    in property <string> gpu-temp: "--";
    in property <string> gpu-clock: "--";
    in property <string> gpu-name: "--";
    in property <string> gpu-vram: "--";
    in property <float> gpu-vram-fraction: -1;
    in property <string> encoder: "--";
    in property <string> decoder: "--";
    in property <[KeyValue]> gpu-kv; // Temp / Encode / Decode
    in property <[string]> gpu-options;
    in-out property <int> gpu-index;
    callback gpu-selected(int);
    // Memory
    in property <float> ram-percent: -1;
    in property <string> ram-usage: "--";
    in property <string> ram-total: "--";
    in property <string> ram-speed: "--";
    in property <string> mem-pressure: "--";
    in property <[StackPart]> mem-parts;
    in property <[LegendItem]> mem-legend;
    in property <[KeyValue]> memory-kv; // Total / Speed / Pressure
    in property <string> pressure-path;
    in property <[KeyValue]> top-memory;
    // Storage (summary pager) and disks
    in property <int> disk-count;
    in property <string> sum-disk-name: "--";
    in property <[KeyValue]> sum-disk-kv;
    callback sum-disk-step(int);
    in property <[DiskRow]> disks;
    in property <string> disk-max: "--";
    in property <string> disk-read-path;
    in property <string> disk-write-path;
    in property <string> disk-read-now: "--";
    in property <string> disk-write-now: "--";
    // Network
    in property <[string]> net-options;
    in-out property <int> net-index;
    callback net-selected(int);
    in property <string> net-ip: "--";
    in property <string> net-mac: "--";
    in property <string> net-gateway: "--";
    in property <string> net-gateway-mac: "--";
    in property <string> net-up-path;
    in property <string> net-down-path;
    in property <string> net-up-mbps: "--";
    in property <string> net-down-mbps: "--";
    // Sensors
    in-out property <int> temp-unit; // 0 = °C, 1 = °F
    callback temp-unit-selected(int);
    in property <[KeyValue]> temps-kv; // CPU / GPU
    in property <[KeyValue]> sensors-short; // first 8
    // Battery (card hidden when absent)
    in property <bool> has-battery;
    in property <string> battery-percent: "--";
    in property <float> battery-fraction: -1;
    in property <string> battery-time: "--";
    in property <string> battery-status: "--";
    in property <[KeyValue]> battery-kv;
}

