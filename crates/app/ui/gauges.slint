import { Theme } from "theme.slint";

// Single-line text whose layout size does not depend on its content. The
// Text sits outside any layout inside a fixed-height box, so changing it
// repaints only the text: a Text inside a layout makes the layout read its
// content-based size, and every update would then invalidate the surrounding
// layouts (and the dashboard masonry), re-evaluating and repainting far more
// than the text. Width comes from the caller (`width`, or stretch).
export component Value {
    in property <string> text;
    in property <length> font-size: 12px;
    in property <int> font-weight: 400;
    in property <color> color: Theme.text;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    height: label.font-metrics.ascent - label.font-metrics.descent;
    label := Text {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.color;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: center;
        overflow: elide;
    }
}

export struct StackPart {
    start: float, // 0..1 offset, from Rust `charts::stack`
    width: float, // 0..1 share
    color: color,
}

export struct LegendItem {
    label: string,
    value: string,
    color: color,
}

export struct KeyValue {
    key: string,
    value: string,
}

// Ring with up to three centred text lines. `percent` < 0 = missing (track only).
// Path maps the viewbox onto (size - stroke) shifted by half the stroke, so a
// viewbox of size - thickness puts the stroke centre line on radius `r`.
export component RingGauge inherits Rectangle {
    in property <float> percent: -1;
    in property <color> arc-color: Theme.cpu;
    in property <length> thickness: 8px;
    in property <string> label;
    in property <string> value: "--";
    in property <string> detail;
    width: 108px;
    height: self.width;
    accessible-role: progress-indicator;
    accessible-label: label;
    accessible-value: value;
    property <float> r: (self.width - thickness) / 2 / 1px;
    // Stop just short of 100 % so the arc's start and end never coincide.
    property <float> p: min(max(percent, 0), 99.99);
    property <angle> a: p * 3.6deg;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 2 * r;
        viewbox-height: 2 * r;
        fill: transparent;
        stroke: Theme.hover;
        stroke-width: thickness;
        commands: "M \{r} 0 A \{r} \{r} 0 1 1 \{r} \{2 * r} A \{r} \{r} 0 1 1 \{r} 0";
    }
    // A round cap draws a dot even at 0 length, so the arc is hidden at 0 %.
    // `visible`, not `if`: a condition on a value that changes every cycle makes
    // Slint re-check the conditional element and render an extra frame.
    Path {
        visible: p > 0;
        width: 100%;
        height: 100%;
        viewbox-width: 2 * r;
        viewbox-height: 2 * r;
        fill: transparent;
        stroke: root.arc-color;
        stroke-width: thickness;
        stroke-line-cap: round;
        commands: "M \{r} 0 A \{r} \{r} 0 \{p > 50 ? 1 : 0} 1 \{r + r * sin(a)} \{r - r * cos(a)}";
    }
    // Value (fixed line height) so changing readings do not re-layout the card.
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        if label != "": Value {
            text: label;
            font-size: 11px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }
        Value {
            text: value;
            font-size: 17px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
        }
        if detail != "": Value {
            text: detail;
            font-size: 10px;
            color: Theme.text-tertiary;
            horizontal-alignment: center;
        }
    }
}

// Horizontal stacked bar with rounded ends on a track. The software renderer
// clips children to a plain rectangle, so the outer segments round their own
// ends (per-corner radii) instead of relying on `clip`.
export component StackBar inherits Rectangle {
    in property <[StackPart]> parts;
    height: 8px;
    border-radius: self.height / 2;
    background: Theme.hover;
    for part in parts: Rectangle {
        property <length> r: part.start <= 0 ? root.height / 2 : 0;
        property <length> e: part.start + part.width >= 0.999 ? root.height / 2 : 0;
        x: part.start * parent.width;
        width: part.width * parent.width;
        height: parent.height;
        background: part.color;
        border-top-left-radius: r;
        border-bottom-left-radius: r;
        border-top-right-radius: e;
        border-bottom-right-radius: e;
    }
}

// Legend rows (dot, label, value) stacked vertically and centred as a block.
export component Legend inherits VerticalLayout {
    in property <[LegendItem]> items;
    alignment: center;
    spacing: 6px;
    for item in items: HorizontalLayout {
        alignment: center;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: item.color;
            }
        }
        Text {
            text: item.label;
            font-size: 12px;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
        Value {
            text: item.value;
            width: 64px;
            font-size: 12px;
            font-weight: 600;
            color: Theme.text;
        }
    }
}

// Key/value grid ("Total / Used / Free"), `columns` per row, values elide.
export component KvGrid inherits Rectangle {
    in property <[KeyValue]> items;
    in property <int> columns: 3;
    property <length> row-height: 40px;
    height: ceil(items.length / max(columns, 1)) * row-height;
    for kv[i] in items: VerticalLayout {
        x: mod(i, max(root.columns, 1)) * root.width / max(root.columns, 1);
        y: floor(i / max(root.columns, 1)) * root.row-height;
        width: root.width / max(root.columns, 1) - 8px;
        height: root.row-height;
        spacing: 1px;
        Value {
            text: kv.key;
            font-size: 11px;
            color: Theme.text-secondary;
        }
        Value {
            text: kv.value;
            font-size: 13px;
            color: Theme.text;
        }
    }
}

// Bar chart drawn from Rust-generated path commands (`charts::bar_path`).
// `up`/`down` are the two halves of a mirrored pair; leave `down` empty for a
// single series.
// - `fixed-width` > 0 (dashboard): Rust draws all kept samples right-aligned
//   on a `fixed-width` × 100 canvas; the viewbox shows its rightmost plot-width
//   pixels at 1:1 (height stretched), so resizing needs no regeneration.
// - otherwise the viewbox equals the plot size in pixels and
//   `geometry-changed` fires on resize so the owner regenerates the paths.
export component BarChart inherits Rectangle {
    in property <string> up;
    in property <string> down;
    in property <color> up-color: Theme.cpu;
    in property <color> down-color: Theme.net-down;
    in property <bool> mirrored;
    in property <float> fixed-width: 0;
    out property <length> plot-width: self.width;
    out property <length> plot-height: self.height;
    callback geometry-changed();
    property <float> vx: fixed-width > 0 ? fixed-width - root.width / 1px : 0;
    property <float> vh: fixed-width > 0 ? 100 : root.height / 1px;
    changed width => { root.geometry-changed(); }
    changed height => { root.geometry-changed(); }
    border-radius: 8px;
    background: Theme.dark ? #00000026 : #0000000a;
    if mirrored: Rectangle {
        y: parent.height / 2;
        height: 1px;
        background: Theme.hover;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: root.vx;
        viewbox-width: root.width / 1px;
        viewbox-height: root.vh;
        fit: fill;
        clip: true;
        commands: root.up;
        fill: root.up-color;
        stroke-width: 0;
    }
    if mirrored: Path {
        width: 100%;
        height: 100%;
        viewbox-x: root.vx;
        viewbox-width: root.width / 1px;
        viewbox-height: root.vh;
        fit: fill;
        clip: true;
        commands: root.down;
        fill: root.down-color;
        stroke-width: 0;
    }
}

// Single-value progress bar (VRAM, battery, disk usage). `fraction` < 0 = missing.
export component ProgressBar inherits Rectangle {
    in property <float> fraction: -1;
    in property <color> fill: Theme.ram;
    height: 6px;
    border-radius: self.height / 2;
    background: Theme.hover;
    Rectangle {
        visible: fraction > 0;
        x: 0;
        width: min(fraction, 1) * parent.width;
        height: parent.height;
        border-radius: parent.height / 2;
        background: root.fill;
    }
}

// Name / value rows (top processes, sensor list); names elide.
export component Rows inherits VerticalLayout {
    in property <[KeyValue]> items;
    spacing: 2px;
    for kv in items: HorizontalLayout {
        height: 22px;
        spacing: 8px;
        Value {
            text: kv.key;
            font-size: 12px;
            color: Theme.text-secondary;
            horizontal-stretch: 1;
        }
        Value {
            text: kv.value;
            width: 84px;
            font-size: 12px;
            color: Theme.text;
            horizontal-alignment: right;
        }
    }
}

// One vertical bar per logical CPU (0..100, < 0 missing), sharing the width.
export component CoreBars inherits Rectangle {
    in property <[float]> values;
    in property <color> fill: Theme.cpu;
    property <length> gap: values.length > 32 ? 1px : 2px;
    property <length> bar: values.length > 0 ? (self.width - (values.length - 1) * gap) / values.length : 0;
    for v[i] in values: Rectangle {
        x: i * (root.bar + root.gap);
        width: root.bar;
        y: 0;
        height: root.height;
        border-radius: 2px;
        background: Theme.hover;
        Rectangle {
            visible: v >= 0;
            y: parent.height - self.height;
            height: max(2px, min(v, 100) / 100 * parent.height);
            border-radius: 2px;
            background: root.fill;
        }
    }
}

// "Show more…" link at the bottom of a card.
export component MoreLink inherits Text {
    callback activated;
    font-size: 12px;
    color: ta.has-hover ? Theme.text : Theme.cpu;
    accessible-role: button;
    accessible-action-default => { root.activated(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}
