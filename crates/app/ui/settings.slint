// Settings page. Every change goes through Rust (`State::commit`): validated by
// core `Settings::apply`, saved to config.json, then applied; an invalid value
// shows its error under the field and is not saved.
import { Theme } from "theme.slint";
import { GlassCard, SectionHeading } from "card.slint";
import { SegmentedControl } from "controls.slint";
import { Value } from "gauges.slint";
import { Dash } from "data.slint";
import { AboutSlint, ScrollView } from "std-widgets.slint";

export global SettingsUi {
    in property <int> update-interval: 500;
    in property <int> history-points: 30;
    in property <int> gpu-index;
    in property <string> net-interface: "all";
    in property <bool> glass;
    // Why glass is unavailable (no blur protocol, X11, compositor blur off).
    in property <string> glass-hint;
    in property <string> interval-error;
    in property <string> history-error;
    in property <string> gpu-error;
    in property <string> net-error;
    // Save failures and other errors not tied to one field.
    in property <string> general-error;
    in property <string> path-text;
    in property <string> load-warning;
    in property <string> refresh-feedback;
    in property <string> version;
    // Bumped by Rust after every commit so edited fields show the stored value again.
    in property <int> revision;
    callback set-interval(int);
    callback set-history(int);
    callback set-gpu(int);
    callback set-net(string);
    callback set-glass(bool);
    // True when the ResourceWatch KWin effect blurs the window; `blur-values`
    // then follow the order of `kwin_blur::FIELDS`.
    in property <bool> blur-custom;
    in property <[int]> blur-values;
    callback set-blur(int, int);
    callback set-theme(string);
    callback refresh(string); // "ipv4" | "disks" | "hardware"
    callback reset();
}

component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked;
    height: 28px;
    min-width: label.preferred-width + 24px;
    border-radius: 8px;
    background: ta.pressed ? Theme.selected : (ta.has-hover ? Theme.hover : (Theme.dark ? #ffffff0f : #0000000a));
    border-width: 1px;
    border-color: Theme.edge-bottom;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        font-size: 12px;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Editable text box; `accepted(text)` on Enter or when focus leaves after an edit.
component InputBox inherits Rectangle {
    in property <string> value;
    in property <int> revision;
    in property <bool> invalid;
    in property <string> label;
    callback accepted(string);
    property <bool> dirty;
    height: 28px;
    border-radius: 8px;
    background: Theme.dark ? #00000033 : #ffffff99;
    border-width: 1px;
    border-color: invalid ? Theme.danger : (input.has-focus ? Theme.cpu : Theme.edge-bottom);
    // Show the stored value again after each commit (also after a rejected one).
    changed revision => {
        input.text = root.value;
        root.dirty = false;
    }
    changed value => {
        if !input.has-focus {
            input.text = root.value;
        }
    }
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.value;
        font-size: 13px;
        color: Theme.text;
        vertical-alignment: center;
        single-line: true;
        accessible-label: root.label;
        edited => { root.dirty = true; }
        accepted => {
            root.dirty = false;
            root.accepted(self.text);
        }
        changed has-focus => {
            if !self.has-focus && root.dirty {
                root.dirty = false;
                root.accepted(self.text);
            }
        }
    }
}

// Number field with −/+ steppers; typed text that is not a number is sent as −1
// so Rust reports the range error.
component NumberField inherits HorizontalLayout {
    in property <int> value;
    in property <int> step;
    in property <int> revision;
    in property <bool> invalid;
    in property <string> unit;
    in property <string> label;
    callback submit(int);
    spacing: 6px;
    SmallButton { text: "−"; width: 28px; clicked => { root.submit(root.value - root.step); } }
    InputBox {
        width: 88px;
        label: root.label;
        value: root.value;
        revision: root.revision;
        invalid: root.invalid;
        accepted(t) => { root.submit(t.is-float() ? round(t.to-float()) : -1); }
    }
    SmallButton { text: "+"; width: 28px; clicked => { root.submit(root.value + root.step); } }
    Text { text: root.unit; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> error;
    spacing: 4px;
    Text { text: root.label; font-size: 13px; font-weight: 600; color: Theme.text; }
    Text { text: root.hint; font-size: 11px; color: Theme.text-secondary; wrap: word-wrap; }
    @children
    if root.error != "": Text { text: root.error; font-size: 11px; color: Theme.danger; wrap: word-wrap; }
}

component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);
    width: 40px;
    height: 22px;
    border-radius: self.height / 2;
    background: checked ? Theme.cpu : Theme.hover;
    opacity: enabled ? 1 : 0.5;
    accessible-role: switch;
    accessible-label: label;
    accessible-checked: checked;
    accessible-action-default => { if root.enabled { root.toggled(!root.checked); } }
    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: parent.height - 6px;
        height: self.width;
        border-radius: self.width / 2;
        background: #ffffff;
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000040;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(!root.checked); }
    }
}

component RefreshRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> detail;
    in property <string> button;
    callback clicked;
    spacing: 12px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text { text: root.title; font-size: 13px; font-weight: 600; color: Theme.text; }
        Text { text: root.detail; font-size: 11px; color: Theme.text-secondary; wrap: word-wrap; }
    }
    VerticalLayout {
        alignment: center;
        SmallButton { text: root.button; clicked => { root.clicked(); } }
    }
}

export component SettingsPage inherits Rectangle {
    property <length> gap: 20px;
    ScrollView {
        content-width: self.visible-width;
        content-height: column.preferred-height;
        column := VerticalLayout {
            x: max(0, (parent.width - self.width) / 2);
            width: min(parent.width, 760px);
            spacing: root.gap;
            padding-bottom: 4px;

            GlassCard {
                title: "監控更新排程";
                Text {
                    text: "所有即時監控、歷史圖表與畫面更新共用一組更新間隔。實際感測器更新率仍受硬體與驅動限制。";
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Field {
                    label: "統一更新間隔";
                    hint: "CPU、GPU、VRAM、RAM、磁碟、網路、歷史圖表與畫面共用；100–10000 ms，步進 50";
                    error: SettingsUi.interval-error;
                    NumberField {
                        label: "統一更新間隔";
                        value: SettingsUi.update-interval;
                        step: 50;
                        unit: "ms";
                        revision: SettingsUi.revision;
                        invalid: SettingsUi.interval-error != "";
                        submit(v) => { SettingsUi.set-interval(v); }
                    }
                }
                Field {
                    label: "歷史資料點數";
                    hint: "詳細頁圖表顯示的紀錄數量；10–120，步進 10";
                    error: SettingsUi.history-error;
                    NumberField {
                        label: "歷史資料點數";
                        value: SettingsUi.history-points;
                        step: 10;
                        unit: "點";
                        revision: SettingsUi.revision;
                        invalid: SettingsUi.history-error != "";
                        submit(v) => { SettingsUi.set-history(v); }
                    }
                }
            }

            GlassCard {
                title: "裝置與手動刷新";
                Field {
                    label: "GPU 編號";
                    hint: "多張顯示卡時從 0 開始指定；0–15";
                    error: SettingsUi.gpu-error;
                    NumberField {
                        label: "GPU 編號";
                        value: SettingsUi.gpu-index;
                        step: 1;
                        revision: SettingsUi.revision;
                        invalid: SettingsUi.gpu-error != "";
                        submit(v) => { SettingsUi.set-gpu(v); }
                    }
                }
                Field {
                    label: "網路介面";
                    hint: "all 為所有實體介面，或指定名稱如 enp3s0（按 Enter 套用）";
                    error: SettingsUi.net-error;
                    HorizontalLayout {
                        InputBox {
                            width: 200px;
                            label: "網路介面";
                            value: SettingsUi.net-interface;
                            revision: SettingsUi.revision;
                            invalid: SettingsUi.net-error != "";
                            accepted(t) => { SettingsUi.set-net(t); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                Rectangle { height: 1px; background: Theme.edge-bottom; }
                RefreshRow {
                    title: "IPv4 位址";
                    detail: "重新查詢目前選取介面的 IPv4";
                    button: "重新讀取 IPv4";
                    clicked => { SettingsUi.refresh("ipv4"); }
                }
                RefreshRow {
                    title: "實體硬碟清單";
                    detail: "重新偵測 SATA／SAS／NVMe／IDE 裝置";
                    button: "重新掃描硬碟";
                    clicked => { SettingsUi.refresh("disks"); }
                }
                RefreshRow {
                    title: "硬體資訊";
                    detail: "重新偵測 CPU／GPU 名稱與 RAM 速度";
                    button: "重新偵測";
                    clicked => { SettingsUi.refresh("hardware"); }
                }
                if SettingsUi.refresh-feedback != "": Text {
                    text: SettingsUi.refresh-feedback;
                    font-size: 11px;
                    color: Theme.text-secondary;
                }
            }

            GlassCard {
                title: "外觀";
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text { text: "毛玻璃"; font-size: 13px; font-weight: 600; color: Theme.text; }
                        Text {
                            text: SettingsUi.glass-hint != "" ? SettingsUi.glass-hint : "視窗半透明並模糊桌面背景，切換立即生效";
                            font-size: 11px;
                            color: SettingsUi.glass-hint != "" ? Theme.warning-text : Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            label: "毛玻璃";
                            checked: SettingsUi.glass;
                            toggled(on) => { SettingsUi.set-glass(on); }
                        }
                    }
                }
                if SettingsUi.blur-custom && SettingsUi.glass: VerticalLayout {
                    spacing: 10px;
                    for f[i] in [
                        { label: "模糊強度", hint: "1–15，越大越模糊", step: 1, unit: "" },
                        { label: "雜訊", hint: "0–100，0 為關閉；可遮住漸層色帶", step: 1, unit: "" },
                        { label: "飽和度", hint: "0–300%，100% 為原色", step: 10, unit: "%" },
                        { label: "對比", hint: "0–300%，100% 為原樣", step: 10, unit: "%" },
                        { label: "亮度", hint: "0–300%，100% 為原樣", step: 10, unit: "%" },
                    ]: Field {
                        label: f.label;
                        hint: f.hint;
                        NumberField {
                            label: f.label;
                            value: SettingsUi.blur-values[i];
                            step: f.step;
                            unit: f.unit;
                            revision: SettingsUi.revision;
                            submit(v) => { SettingsUi.set-blur(i, v); }
                        }
                    }
                }
                if !SettingsUi.blur-custom && SettingsUi.glass: Text {
                    text: "目前使用系統（KWin）的模糊，強度由系統設定決定。執行 kwin-effect/build.sh 安裝 ResourceWatch 模糊外掛並重新登入後，可在此單獨調整。";
                    font-size: 11px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "主題"; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    SegmentedControl {
                        options: ["跟隨系統", "深色", "淺色"];
                        current: Theme.mode == "dark" ? 1 : (Theme.mode == "light" ? 2 : 0);
                        selected(i) => { SettingsUi.set-theme(i == 1 ? "dark" : (i == 2 ? "light" : "system")); }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "溫度單位"; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    SegmentedControl {
                        options: ["°C", "°F"];
                        current: Dash.temp-unit;
                        selected(i) => { Dash.temp-unit-selected(i); }
                    }
                }
            }

            GlassCard {
                title: "關於";
                Text { text: "ResourceWatch \{SettingsUi.version}"; font-size: 14px; font-weight: 700; color: Theme.text; }
                Text {
                    text: "Linux 桌面資源監控。資料直接讀取 /proc、sysfs、hwmon 與 NVML，不啟動外部程序、不連外網。授權：MIT。";
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                SectionHeading { text: "介面框架"; }
                // Required by the Slint Royalty-free license.
                HorizontalLayout {
                    AboutSlint { max-width: 180px; }
                    Rectangle { horizontal-stretch: 1; }
                }
                SectionHeading { text: "圖示"; }
                Text {
                    text: "網路卡片圖示：Font Awesome Free 7.3.1 by @fontawesome — https://fontawesome.com，授權 CC BY 4.0（https://fontawesome.com/license/free）。";
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    SmallButton { text: "恢復預設值"; clicked => { SettingsUi.reset(); } }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: "變更通過驗證後立即套用並儲存；無效的值不會儲存。\{SettingsUi.path-text}";
                        font-size: 11px;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                    if SettingsUi.general-error != "": Text { text: SettingsUi.general-error; font-size: 11px; color: Theme.danger; wrap: word-wrap; }
                    if SettingsUi.load-warning != "": Text { text: SettingsUi.load-warning; font-size: 11px; color: Theme.warning-text; wrap: word-wrap; }
                }
            }
        }
    }
}
