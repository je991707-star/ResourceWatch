// Glass surfaces. The software renderer's Rectangle border double-blends pixels
// on the arc (bright beads = jagged corners), so the fill is a border-less
// rounded Rectangle and the 1px edge is drawn separately: straight Rectangles
// plus small corner Paths. A Path is re-rasterised on every repaint, so only
// the r×r corners are Paths, never a panel-sized one.

// Quarter arc of a 1px edge; `commands` places the arc for one corner.
component EdgeArc inherits Path {
    in property <length> radius;
    width: radius;
    height: radius;
    // Path maps the viewbox onto (size - stroke-width) shifted by half the
    // stroke, so a viewbox of radius - 1 is 1:1 with pixels.
    viewbox-width: radius / 1px - 1;
    viewbox-height: radius / 1px - 1;
    fill: transparent;
    stroke-width: 1px;
}

// Rounded translucent panel with a 1px highlight: `edge-top` along the top,
// fading to `edge-bottom` down the sides and along the bottom.
export component GlassPanel inherits Rectangle {
    in property <length> radius;
    in property <brush> fill;
    in property <color> edge-top;
    in property <color> edge-bottom;
    border-radius: radius;
    background: fill;
    // Stroke centre-line radius (outer radius = `radius`) and viewbox extent.
    property <float> a: radius / 1px - 0.5;
    property <float> v: radius / 1px - 1;
    property <brush> side: @linear-gradient(180deg, edge-top 0%, edge-bottom 100%);
    Rectangle { x: radius; y: 0; width: parent.width - 2 * radius; height: 1px; background: edge-top; }
    Rectangle { x: radius; y: parent.height - 1px; width: parent.width - 2 * radius; height: 1px; background: edge-bottom; }
    Rectangle { x: 0; y: radius; width: 1px; height: parent.height - 2 * radius; background: side; }
    Rectangle { x: parent.width - 1px; y: radius; width: 1px; height: parent.height - 2 * radius; background: side; }
    if radius > 1px: EdgeArc {
        x: 0;
        y: 0;
        radius: root.radius;
        stroke: edge-top;
        commands: "M 0 \{a} A \{a} \{a} 0 0 1 \{a} 0";
    }
    if radius > 1px: EdgeArc {
        x: parent.width - root.radius;
        y: 0;
        radius: root.radius;
        stroke: edge-top;
        commands: "M -0.5 0 A \{a} \{a} 0 0 1 \{v} \{a}";
    }
    if radius > 1px: EdgeArc {
        x: parent.width - root.radius;
        y: parent.height - root.radius;
        radius: root.radius;
        stroke: edge-bottom;
        commands: "M \{v} -0.5 A \{a} \{a} 0 0 1 -0.5 \{v}";
    }
    if radius > 1px: EdgeArc {
        x: 0;
        y: parent.height - root.radius;
        radius: root.radius;
        stroke: edge-bottom;
        commands: "M \{a} \{v} A \{a} \{a} 0 0 1 0 -0.5";
    }
    @children
}
